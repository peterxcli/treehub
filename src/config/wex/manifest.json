{
  "name": "TreeHub",
  "version": "$VERSION",
  "description": "Code tree for GitHub with pull request review tools: changed files, review threads, full-file diffs and PR navigation.",
  "homepage_url": "https://github.com/peterxcli/treehub",
  "author": "peterxcli",
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["*.woff2", "*.png", "*.gif"],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
