{
  "name": "treehub",
  "version": "2.0.0",
  "private": true,
  "description": "Code tree for GitHub with pull request review tools, repository bookmarks and a review queue",
  "scripts": {
    "start": "node scripts/build.js --watch",
    "watch": "node scripts/build.js --watch",
    "build": "node scripts/build.js",
    "dist": "node scripts/build.js --dist",
    "test": "node --no-warnings --test 'test/*.test.*'",
    "typecheck": "vue-tsc --noEmit -p app",
    "lint": "eslint src scripts test",
    "publish:chrome": "node scripts/publish-chrome.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peterxcli/treehub"
  },
  "author": "peterxcli",
  "contributors": [
    "Buu Nguyen <buunguyen@gmail.com> (https://github.com/buunguyen)"
  ],
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/peterxcli/treehub/issues"
  },
  "homepage": "https://github.com/peterxcli/treehub",
  "devDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@types/chrome": "^0.3.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^8.57.1",
    "less": "^4.4.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=18"
  }
}
