{
  "name": "treehub-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "make gen",
    "build": "make worker",
    "dev": "make worker && wrangler dev --port 8787",
    "deploy": "make worker && wrangler deploy",
    "test": "make test",
    "smoke": "node scripts/smoke.mjs http://localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "wrangler": "^4.143.1"
  }
}
